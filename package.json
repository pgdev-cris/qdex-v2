{
    "name": "qdex-v2",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "dev": "concurrently --kill-others --names \"API,WEB\" \"npm run dev:api\" \"npm run dev:web\"",
        "dev:api": "npm run dev --prefix backend",
        "dev:web": "npm run dev --prefix frontend",
        "build": "npm run build --prefix backend && npm run build --prefix frontend",
        "install:all": "npm install && npm install --prefix frontend && npm install --prefix backend",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "format:backend": "prettier --write backend/src",
        "format:frontend": "prettier --write frontend/src",
        "lint": "npm run lint --prefix frontend && npm run lint --prefix backend",
        "lint:fix": "npm run lint:fix --prefix frontend && npm run lint:fix --prefix backend",
        "migrate:to-arrow": "node scripts/to-arrow.mjs"
    },
    "devDependencies": {
        "@types/jsonwebtoken": "^9.0.10",
        "concurrently": "^8.0.0",
        "prettier": "^3.8.1",
        "ts-morph": "^27.0.2"
    },
    "author": "",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "jsonwebtoken": "^9.0.3",
        "zod": "^4.3.6"
    }
}
